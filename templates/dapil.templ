package templates

import (
	"datapemilu2024/internal/models"
	"fmt"
)

templ DapilPage(dapils []models.Dapil, provinceCode string, provinceName string) {
	@Layout(fmt.Sprintf("Data Dapil - %s", provinceName)) {
		<div class="animate-slide-in">
			<div class="mb-6">
				<a href="/" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-4">
					<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
					</svg>
					Kembali ke Daftar Provinsi
				</a>
				<h2 class="text-3xl font-bold text-gray-800 mb-2">Data Daerah Pemilihan (Dapil) DPR RI</h2>
				<p class="text-gray-600">{ provinceName } - Kode: { provinceCode }</p>
			</div>
			<div class="bg-white rounded-2xl shadow-xl overflow-hidden card-hover">
				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200">
						<thead class="bg-gradient-to-r from-indigo-600 to-purple-600">
							<tr>
								<th class="px-6 py-4 text-left text-xs font-bold text-white uppercase tracking-wider">
									No
								</th>
								<th class="px-6 py-4 text-left text-xs font-bold text-white uppercase tracking-wider">
									Nama Dapil
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									Kode Dapil
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									Jumlah Kursi
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									Jumlah Caleg
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									Jumlah Partai
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									Data Perdesa
								</th>
								<th class="px-6 py-4 text-center text-xs font-bold text-white uppercase tracking-wider">
									DATA SUARA TPS
								</th>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							for i, dapil := range dapils {
								<tr class="hover:bg-indigo-50 transition-colors duration-200">
									<td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
										{ fmt.Sprintf("%d", i+1) }
									</td>
									<td class="px-6 py-4">
										<div class="text-sm font-semibold text-gray-900">{ dapil.Name }</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<span class="text-sm text-gray-600 font-mono">{ dapil.Code }</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
											{ fmt.Sprintf("%d", dapil.JumlahKursi) }
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
											{ fmt.Sprintf("%d", dapil.JumlahCaleg) }
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
											{ fmt.Sprintf("%d", dapil.JumlahPartai) }
										</span>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<div class="flex flex-wrap gap-1 justify-center">
											<a href={ templ.SafeURL(fmt.Sprintf("/download/dapil/pilpres/%s", dapil.Code)) }
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-red-600 hover:bg-red-700 rounded transition-colors">
												PILPRES
											</a>
											<a href={ templ.SafeURL(fmt.Sprintf("/download/dapil/dpr-ri-partai/%s", dapil.Code)) }
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-green-600 hover:bg-green-700 rounded transition-colors">
												DPR RI PARTAI
											</a>
											<a href={ templ.SafeURL(fmt.Sprintf("/download/dapil/dpr-ri-caleg/%s", dapil.Code)) }
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-teal-600 hover:bg-teal-700 rounded transition-colors">
												DPR RI CALEG
											</a>
										</div>
									</td>
									<td class="px-6 py-4 whitespace-nowrap text-center">
										<div class="flex flex-wrap gap-1 justify-center">
											<a href="#"
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-gray-400 rounded transition-colors cursor-not-allowed"
											   title="Belum tersedia">
												PILPRES
											</a>
											<a href={ templ.SafeURL(fmt.Sprintf("/download/dapil/dpr-ri-partai-tps/%s", dapil.Code)) }
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-green-600 hover:bg-green-700 rounded transition-colors">
												DPR RI PARTAI
											</a>
											<a href={ templ.SafeURL(fmt.Sprintf("/download/dapil/dpr-ri-caleg-tps/%s", dapil.Code)) }
											   class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-teal-600 hover:bg-teal-700 rounded transition-colors">
												DPR RI CALEG
											</a>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="mt-6 bg-indigo-50 border-l-4 border-indigo-500 p-4 rounded-lg">
				<div class="flex">
					<div class="flex-shrink-0">
						<svg class="h-5 w-5 text-indigo-500" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="ml-3">
						<p class="text-sm text-indigo-700">
							<strong>Total Dapil:</strong> { fmt.Sprintf("%d dapil", len(dapils)) }
						</p>
					</div>
				</div>
			</div>
		</div>
	}
}
